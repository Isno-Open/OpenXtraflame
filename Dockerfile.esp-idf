# La version d'ESP-IDF du projet se declare ICI et nulle part ailleurs :
# scripts/release.sh et docker-compose.yml la lisent dans cette ligne.
FROM espressif/idf:v6.1

WORKDIR /project

RUN apt-get update && apt-get install -y --no-install-recommends \
    less \
    vim \
    && rm -rf /var/lib/apt/lists/*

ENV IDF_TARGET=esp32

CMD ["/bin/bash"]
